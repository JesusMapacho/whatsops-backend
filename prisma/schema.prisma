generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  agent
}

enum WabaSource {
  embedded_signup
  manual_token
  waha_qr // emparejado escaneando un QR contra una instancia WAHA (v5 feature 26)
}

// Transporte/canal de una conexión. whatsapp/instagram/messenger son canales
// oficiales de Meta (v2 feature 15); `waha` es WhatsApp por un transporte NO
// oficial self-hosted (WhatsApp Web vía https://waha.devlike.pro, v5 feature 26).
//
// ponytail: waha vive en este enum y no en una columna `provider` ortogonal porque
// un número no puede estar en Cloud API y en WhatsApp Web a la vez, así que
// channelAdapter(platform), el @@unique([platform, phoneNumberId]) que resuelve
// tenant y la pureza sin-DB de decode.ts siguen funcionando sin tocarse.
// Techo: si un tenant migra WAHA→Cloud API su historial se parte en dos
// Contact/Conversation. Upgrade: columna `provider` + backfill que reescribe
// platform='waha'→'whatsapp' y fusiona Contacts por waId normalizado.
enum Platform {
  whatsapp
  instagram
  messenger
  waha
}

enum ConversationStatus {
  open
  pending
  closed
}

enum MessageDirection {
  in
  out
}

enum MessageStatus {
  sent
  delivered
  read
  failed
}

enum WebhookProcessStatus {
  pending
  ok
  failed
}

// --- CRM (v8 features 34-38) ---

// Cierre del trato. Es COLUMNA y no una etapa del tablero: como etapas se perdería la
// conversión POR etapa (¿cuántos de los que llegaron a cotización cerraron?), el monto
// ganado dejaría de ser sumable sin adivinar cuál columna final cuenta, y borrar esa
// etapa borraría el histórico de ventas.
enum DealStatus {
  open
  won
  lost
}

enum TaskType {
  call
  whatsapp
  email
  meeting
  other
}

// Lo que puede aparecer en el timeline de un contacto. Los tres primeros los registra
// una persona (allowlist de `POST /activities`); el resto los escribe el servidor
// cuando pasan — si el cliente pudiera inyectarlos, el timeline sería un cuento.
enum ActivityType {
  note
  call
  meeting
  stage_change
  deal_created
  deal_won
  deal_lost
  task_done
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  plan      String   @default("free")
  status    String   @default("active")
  // Datos de empresa (internacional) capturados en el onboarding.
  country   String? // ISO-3166-1 alpha-2
  timezone  String? // IANA
  currency  String? // ISO-4217
  locale    String? // BCP-47 / locale
  // Estado del registro por pasos (admin-v2 feature 03).
  onboardingStep     Int     @default(1)
  onboardingComplete Boolean @default(false)
  // Branding white-label (v2 feature 16). name (arriba) = nombre del negocio.
  accentColor String? // hex #rrggbb; null = usa el acento por defecto del sistema
  logoKey     String? // key de StorageService; null = sin logo
  // Cuándo aceptó este negocio el aviso de escribir a desconocidos (v5 feature 29).
  // null = todavía no; el servidor lo exige, no la UI.
  coldOutreachAckedAt DateTime?
  // Regla de alta automática de tratos (v8 feature 38): un entrante de quien no tiene
  // trato abierto crea uno en la primera etapa. APAGADO por defecto, igual que
  // COLD_OUTREACH_ENABLED: una regla que crea filas sola se enciende a mano.
  autoDealOnInbound Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  roles           Role[]
  wabaConnections WabaConnection[]
  contacts        Contact[]
  conversations   Conversation[]
  messages        Message[]
  webhookEvents   WebhookEvent[]
  templates       Template[]
  cannedResponses CannedResponse[]
  paymentMethods  PaymentMethod[]
  broadcasts      Broadcast[]
  statusPosts     StatusPost[]
  contactLists    ContactList[]
  subscription    Subscription?
  invitations     Invitation[]
  pipelines       Pipeline[]
  stages          Stage[]
  deals           Deal[]
  tasks           Task[]
  activities      Activity[]
  tags            Tag[]
}

// Método de pago de la suscripción a WhatsOps. NUNCA guarda el PAN: solo
// tokens/identificadores del proveedor (Stripe) + brand/last4 no sensibles.
model PaymentMethod {
  id                      String   @id @default(cuid())
  tenantId                String
  providerCustomerId      String?
  providerPaymentMethodId String?
  brand                   String?
  last4                   String?
  status                  String   @default("pending") // pending | active | removed
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// Suscripción a WhatsOps (una por tenant en el MVP).
model Subscription {
  id                     String    @id @default(cuid())
  tenantId               String    @unique
  plan                   String    @default("free")
  status                 String    @default("inactive") // inactive | active | past_due | canceled
  providerSubscriptionId String?
  periodStart            DateTime?
  periodEnd              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// RBAC: roles configurables por tenant. admin/agent se siembran como isSystem
// para compatibilidad con el enum UserRole.
model Role {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users        User[]
  permissions  RolePermission[]
  contactLists ContactListRole[]
  invitations  Invitation[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

// Invitación a unirse a un tenant. Se guarda SOLO el hash del token, igual que
// VerificationCode: quien lea la base de datos no puede entrar con el enlace.
//
// El hash es sha256 y no bcrypt porque aquí hay que BUSCAR por el token (la
// persona invitada solo trae eso), así que tiene que ser determinista e
// indexable. El secreto son 32 bytes aleatorios, no un código de 6 dígitos: no
// hay nada que salar ni que encarecer.
model Invitation {
  id          String    @id @default(cuid())
  tenantId    String
  email       String
  roleId      String?
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  // Quién invitó. Sin FK a propósito: borrar a quien invitó no debe borrar la
  // invitación ni bloquear su baja.
  invitedById String?
  note        String? // nota de bienvenida; se enseña en la pantalla de aceptar
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role?  @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@index([tenantId])
}

// Catálogo de permisos: la clave (recurso:accion) se siembra desde código
// (permissions.catalog.ts). No lleva tenantId: el catálogo es global; las
// asignaciones por tenant viven en RolePermission.
model Permission {
  id    String @id @default(cuid())
  key   String @unique

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  role         UserRole @default(agent)
  roleId       String?
  status       String   @default("active") // active | disabled
  isPlatform   Boolean  @default(false)    // super-admin operador (cross-tenant)
  firstName     String?
  lastName      String?
  phone         String?  // E.164
  phoneVerified Boolean  @default(false)
  emailVerified Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleRef             Role?          @relation(fields: [roleId], references: [id], onDelete: SetNull)
  assignedConversations Conversation[] @relation("AssignedAgent")
  verificationCodes   VerificationCode[]
  broadcasts          Broadcast[]
  statusPosts         StatusPost[]
  contactLists        ContactList[]
  contactListMembers  ContactListMember[]
  ownedContacts       Contact[]  @relation("ContactOwner")
  ownedDeals          Deal[]     @relation("DealOwner")
  assignedTasks       Task[]     @relation("TaskAssignee")
  createdTasks        Task[]     @relation("TaskCreator")
  activities          Activity[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

// Código de verificación de un solo uso. Se guarda SOLO el hash del código
// (nunca el valor en claro), con expiración, tope de intentos y rate-limit por
// createdAt. Purpose/channel son strings validados en código.
model VerificationCode {
  id         String    @id @default(cuid())
  userId     String
  channel    String // email | sms | whatsapp
  purpose    String // password_reset | email_verify | phone_verify
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model WabaConnection {
  id              String     @id @default(cuid())
  tenantId        String
  platform        Platform   @default(whatsapp)
  // Nombre que le pone el negocio para reconocerla ("Ventas", "Sucursal centro").
  //
  // Hace falta porque `phoneNumberId` no es legible: en WAHA es el nombre de sesión
  // DERIVADO del tenant (`t_cmsi4pfjh001r5g8svpwuoe08`), así que los selectores de
  // "enviar desde" mostraban eso. Con varios números conectados era imposible acertar.
  label           String?
  wabaId          String? // WhatsApp only
  // Id externo del canal: phone_number_id (WA) / page id (Messenger) / IG id /
  // nombre de sesión (WAHA, derivado del tenantId — ver wahaSessionName).
  phoneNumberId   String
  // Secreto cifrado (AES-256-GCM): access token de Meta / X-Api-Key de la
  // instancia WAHA. Nunca se expone ni se loguea.
  accessTokenEnc  String
  businessId      String? // WhatsApp only
  // URL base de la instancia WAHA (BYO). null ⇒ Meta, o la instancia gestionada de env.
  baseUrl         String?
  source          WabaSource
  // Meta: 'active'. WAHA: el estado vivo de la sesión (STARTING / SCAN_QR_CODE /
  // WORKING / FAILED …), alimentado por el evento session.status del webhook.
  status          String     @default("active")
  // Versión de la lista de eventos suscritos en la sesión de WAHA. La config del
  // webhook se fija al CREAR la sesión, así que una sesión ya emparejada se queda
  // con la lista vieja y los eventos nuevos no llegarían nunca, en silencio.
  // Se compara contra WAHA_EVENTS_VERSION y se re-suscribe una vez.
  // Es un entero y no una comparación de arrays a propósito: si WAHA devolviera
  // los eventos reordenados, una comparación que no converge reiniciaría todas
  // las sesiones de la flota en cada pasada de reconciliación.
  webhookVersion  Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  broadcasts    Broadcast[]
  statusPosts   StatusPost[]

  @@unique([platform, phoneNumberId])
  @@index([tenantId])
}

// Envío masivo en frío (v5 feature 29).
//
// Existe como tabla por una razón que decide sola: los destinatarios que fallan
// ANTES de que exista un Message (número inválido, sin WhatsApp, tope alcanzado,
// cuenta suspendida) no tienen dónde colgar el motivo — y "quién no lo recibió y por
// qué" es la única pregunta que se hace después de un envío.
model Broadcast {
  id               String   @id @default(cuid())
  tenantId         String
  wabaConnectionId String
  createdById      String
  // 'text' (WAHA) | 'template' (Cloud API, la única forma legal de escribir en frío).
  type             String
  text             String?
  templateName     String?
  templateLanguage String?
  // running | paused | canceled | done
  status           String   @default("running")
  // Por qué se pausó o canceló: tope alcanzado, cortacircuitos, o el operador.
  reason           String?
  // Fallos SEGUIDOS. Se reinicia a 0 con cada envío bueno; al llegar al tope, pausa.
  consecutiveFailures Int   @default(0)
  total            Int
  sent             Int      @default(0)
  failed           Int      @default(0)
  skipped          Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  wabaConnection WabaConnection       @relation(fields: [wabaConnectionId], references: [id], onDelete: Cascade)
  createdBy      User                 @relation(fields: [createdById], references: [id])
  recipients     BroadcastRecipient[]

  @@index([tenantId, status])
}

// Estado publicado ("historia" de WhatsApp). Solo existe en el transporte por QR: la
// API oficial de Meta no puede publicar estados.
//
// Se guarda registro porque sin él el operador no puede responder "¿qué se publicó
// ayer?" ni la consola de plataforma detectar un abuso. Además es lo que hace de
// contador para el cupo diario.
model StatusPost {
  id               String   @id @default(cuid())
  tenantId         String
  wabaConnectionId String
  createdById      String
  // text | image | video | voice
  type             String
  text             String?
  // Copia propia del media en nuestro storage (key), para poder mostrar qué se
  // publicó cuando el estado ya expiró en WhatsApp.
  mediaKey         String?
  mimeType         String?
  caption          String?
  backgroundColor  String?
  // A cuántos contactos se envió. `null` = a TODA la libreta (que en un número de
  // negocio son todos los que han escrito alguna vez).
  audienceCount    Int?
  createdAt        DateTime @default(now())

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  wabaConnection WabaConnection @relation(fields: [wabaConnectionId], references: [id], onDelete: Cascade)
  createdBy      User           @relation(fields: [createdById], references: [id])

  @@index([tenantId, createdAt])
}

model BroadcastRecipient {
  id          String    @id @default(cuid())
  broadcastId String
  phone       String
  // Contacto de la cartera, cuando el envío sale de una (v5 feature 30). Presente
  // significa que su `waId` YA es canónico: el worker no tiene que preguntar el chatId
  // ni construirlo, que es lo que fallaba en silencio con números escritos a mano.
  //
  // No sirve reusar `phone` para esto: en los contactos de Cloud API es NULL, y el eje
  // común de identidad es el Contact, no el teléfono.
  contactId   String?
  // Valores de las variables de la plantilla, resueltos en la SUBIDA. Así el worker
  // no necesita el CSV: no hay que guardarlo (es PII de gente que todavía no es
  // cliente) y el job de la cola sigue pesando ~30 bytes.
  vars        Json?
  // pending | sent | failed | skipped
  status      String    @default("pending")
  reason      String?
  messageId   String?
  sentAt      DateTime?

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  // Todo el deduplicado del envío, en una línea: `createMany({ skipDuplicates })`
  // colapsa los repetidos del CSV sin recorrerlos a mano.
  @@unique([broadcastId, phone])
  @@index([broadcastId, status])
  // Declarado aquí para cerrar una deriva: la migración de v5-30
  // (20260810200000_broadcast_desde_cartera) ya crea este índice, pero el esquema no lo
  // decía, así que cualquier `migrate dev` posterior generaba un DROP INDEX ajeno al
  // cambio que se estuviera haciendo. Postgres no indexa las FK solo, y el índice se
  // quiere: el borrado de un contacto pasa por aquí.
  @@index([contactId])
}

model Contact {
  id        String   @id @default(cuid())
  tenantId  String
  platform  Platform @default(whatsapp)
  // Id externo del usuario en el canal: wa_id (WA) / PSID (Messenger) / IGSID (IG) /
  // chatId `<numero>@c.us` (WAHA — se guarda verbatim, así el envío no transforma nada).
  waId      String
  name      String?
  // Teléfono real en dígitos. Con LID addressing el `waId` NO es un número
  // (`175647100039313@lid`), y las APIs de chats/historial devuelven `@c.us`:
  // sin un eje común se crearían dos contactos y dos hilos para la misma persona.
  // Sale de `_data.key.remoteJidAlt` en los eventos con LID.
  phone     String?
  // Chat de grupo (`@g.us`). El "contacto" es entonces el grupo, y el autor de
  // cada mensaje va en `Message.payload.author`.
  isGroup   Boolean  @default(false)
  // Foto de perfil ya descargada, guardada en el storage. Se refresca sola cada vez
  // que se abre el hilo (que es cuando ya se pedía a WAHA), y así la bandeja puede
  // pintarla sin una petición por fila: bajarla al vuelo para 200 conversaciones
  // sería justo el patrón de automatización que hace que baneen el número.
  avatarKey String?
  // --- CRM (v8 feature 35). Editables; la IDENTIDAD (waId, phone) no lo es: cambiarla
  // a mano rompe el emparejado de los mensajes entrantes.
  email     String?
  // Empresa como TEXTO y no tabla `Company`: agrupar y filtrar "todos los de ACME" ya
  // funciona con un índice. La tabla cuando alguien necesite datos PROPIOS de la empresa
  // (RFC, dirección de facturación, jerarquía), no solo agrupar por nombre.
  company   String?
  // Vendedor dueño de la relación. SetNull: dar de baja a alguien no borra sus clientes.
  ownerId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner         User?          @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  conversations Conversation[]
  listMembers   ContactListMember[]
  broadcastRows BroadcastRecipient[]
  deals         Deal[]
  tasks         Task[]
  activities    Activity[]
  tags          ContactTag[]

  @@unique([tenantId, platform, waId])
  @@index([tenantId])
  @@index([tenantId, phone])
  @@index([tenantId, company])
  @@index([tenantId, ownerId])
}

// Cartera de clientes (v5 feature 30). Un subconjunto CURADO de Contact, no una copia:
// los miembros apuntan al Contact que ya existe, cuyo `waId` vino de una conversación
// real. Eso es justo lo que hace fiable enviar a una cartera — un chatId fabricado a
// mano no existe en México (`52 871…` no es el wa_id `521871…`) y un estado dirigido
// ahí devuelve 201 sin que lo vea nadie.
model ContactList {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  // La cartera "Todos", creada y rellenada por el sistema con quien nos escribe. No se
  // puede borrar ni renombrar: es el suelo sobre el que se arman las demás.
  isSystem    Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  members   ContactListMember[]
  roles     ContactListRole[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model ContactListMember {
  contactListId String
  contactId     String
  addedById     String?
  addedAt       DateTime @default(now())

  contactList ContactList @relation(fields: [contactListId], references: [id], onDelete: Cascade)
  contact     Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  addedBy     User?       @relation(fields: [addedById], references: [id], onDelete: SetNull)

  // Clave compuesta: un contacto está o no está en la cartera, no hay más estado. Y de
  // paso hace idempotente el alta automática desde el worker del webhook.
  @@id([contactListId, contactId])
  @@index([contactId])
}

// Quién puede usar y gestionar la cartera. Por ROL y no por usuario: así no hay que
// tocar accesos cada vez que entra o sale alguien del equipo.
//
// Una cartera SIN ninguna fila aquí es solo de admin — default cerrado, ver access.ts.
model ContactListRole {
  contactListId String
  roleId        String
  // Además de usarla, puede editarla y dar de alta/baja miembros.
  canManage     Boolean @default(false)

  contactList ContactList @relation(fields: [contactListId], references: [id], onDelete: Cascade)
  role        Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([contactListId, roleId])
  @@index([roleId])
}

model Conversation {
  id               String             @id @default(cuid())
  tenantId         String
  platform         Platform           @default(whatsapp)
  contactId        String
  wabaConnectionId String
  status           ConversationStatus @default(open)
  assignedUserId   String?
  lastInboundAt    DateTime?
  lastReadAt       DateTime?
  // ¿La abrimos NOSOTROS escribiendo primero? (v5 feature 30)
  //
  // Hace falta y no es derivable: en cuanto el contacto contesta, una conversación que
  // abrimos nosotros y una que abrió él son indistinguibles (las dos tienen entrante y
  // saliente). Y derivarlo de "la dirección del mensaje más antiguo" NO es estable: el
  // import de historial (feature 28) inserta mensajes más viejos que el primero y
  // voltearía la respuesta.
  //
  // Solo las conversaciones con esto en true entran en el ciclo de vida de
  // prospección: atender a quien nos buscó no lleva ventana ni enfriamiento, o un
  // agente se quedaría bloqueado contestando a un cliente de hace tres días.
  initiatedByUs    Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact        Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  wabaConnection WabaConnection @relation(fields: [wabaConnectionId], references: [id], onDelete: Cascade)
  assignedUser   User?          @relation("AssignedAgent", fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages       Message[]
  // Las notas del hilo viven aquí desde el v8: `Note` se absorbió en `Activity` para que
  // una nota escrita en la bandeja también se vea en la ficha del cliente.
  activities     Activity[]

  @@index([tenantId])
  @@index([tenantId, status])
  // Conteo de conversaciones en frío (lastInboundAt null) para el tope de primer
  // contacto, y ritmo por contacto (que antes se contaba por conversación, con lo
  // que cerrar el hilo reseteaba el tope anti-baneo).
  @@index([tenantId, lastInboundAt])
  @@index([tenantId, contactId])
}

model Message {
  id             String           @id @default(cuid())
  tenantId       String
  conversationId String
  direction      MessageDirection
  type           String
  // Además del contenido, lleva lo que no se consulta y solo se renderiza:
  // `text.body` (normalizado en TODOS los canales), `mediaKey`, `caption`,
  // `replyToWamid`, `editedAt`, `reactions`, `author` (grupos), `voice`,
  // `viaDevice` (enviado desde el teléfono del dueño). Nada de eso es columna:
  // no se filtra ni se ordena por ello, y payload ya viaja por el socket.
  payload        Json
  wamid          String?
  status         MessageStatus    @default(sent)
  // Mensaje borrado por su autor (`message.revoked`). Sí es columna porque se
  // excluye del SQL de no-leídos y de la búsqueda.
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Único POR TENANT, no global: el id de un mensaje de grupo lo genera el
  // remitente y es idéntico para todos los destinatarios, así que con un unique
  // global, en cuanto dos tenants comparten un grupo, el mensaje del segundo se
  // descartaría en silencio (el peor fallo posible de este producto).
  @@unique([tenantId, wamid])
  @@index([tenantId])
  @@index([conversationId])
}

model WebhookEvent {
  id             String               @id @default(cuid())
  tenantId       String?
  type           String
  rawPayload     Json
  signatureValid Boolean
  processStatus  WebhookProcessStatus @default(pending)
  error          String?
  processedAt    DateTime?
  createdAt      DateTime             @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([processStatus])
}

model Template {
  // Componentes CRUDOS de Meta. Se guardan enteros y NO como "número de variables"
  // porque el cuerpo de envío hay que RECONSTRUIRLO con la misma forma, y una
  // cabecera puede ser texto, imagen o documento — cosas que un contador no
  // distingue. Los parámetros se derivan al LEER (una columna derivada se quedaría
  // vieja tras un sync).
  components Json?
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  language  String
  category  String?
  status    String?
  body      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name, language])
  @@index([tenantId])
}

// Log core de errores de la API. tenantId/userId nullable (errores pre-auth o
// de plataforma). requestBody/query se guardan REDACTADOS (redact.ts): jamás
// tokens, passwords ni PAN. Sin FK: un usuario borrado no debe romper el log.
model ErrorLog {
  id           String   @id @default(cuid())
  tenantId     String?
  userId       String?
  method       String
  path         String
  statusCode   Int
  requestBody  Json?
  query        Json?
  errorMessage String
  errorCode    String?
  stack        String?
  requestId    String
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@index([statusCode])
  @@index([path])
  @@index([createdAt])
}

// --- CRM (v8) ---------------------------------------------------------------
//
// La separación que sostiene el lote entero: `Contact` es la PERSONA (datos fijos e
// históricos) y `Deal` es la VENTA concreta que se le intenta cerrar ahora. A la misma
// persona se le venden tres cosas en cinco años, cada una con su monto y su proceso.
// Colgar el monto del contacto —o de la conversación— hace imposible la única pregunta
// que justifica un CRM: ¿cuánto dinero hay en curso?
//
// Y `Conversation` NO sirve de trato aunque lo parezca (tiene estado, dueño y fecha): un
// hilo es un canal, lleva la venta de marzo y la de septiembre, cerrarlo no es ganar
// nada, y no tiene dónde poner $3,000. `ConversationStatus` se queda para lo que es.

// El embudo del negocio. Varias por tenant y no es adelantarse: quien instala paneles y
// además vende mantenimiento tiene dos procesos con etapas distintas, y en un solo
// tablero se mezclan dos embudos que no se comparan. Soportarlo ahora cuesta esta tabla;
// añadirlo después cuesta migrar todos los Deal. La UI solo pinta el selector si hay >1.
model Pipeline {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages Stage[]
  deals  Deal[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

// Etapa ABIERTA del embudo. Ganado/perdido no están aquí: son `Deal.status`.
model Stage {
  id         String @id @default(cuid())
  tenantId   String
  pipelineId String
  name       String
  // SIN @@unique([pipelineId, position]): un unique obliga a valores temporales para
  // intercambiar dos etapas. Reordenar reescribe TODAS las posiciones de la pipeline en
  // una transacción, que es una query y no tiene estados intermedios que proteger.
  position   Int
  // Automatismo de etapa (feature 38): dos columnas, no un motor de reglas. Cubre "al
  // mandar cotización, recuérdame llamar en 2 días" con cero infraestructura. El día que
  // alguien pida condiciones o ramas, eso ES el orquestador v3 y no se construye dos veces.
  autoTaskTitle String?
  autoTaskDays  Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@index([pipelineId, position])
  @@index([tenantId])
}

model Deal {
  id         String     @id @default(cuid())
  tenantId   String
  contactId  String
  pipelineId String
  stageId    String
  title      String
  // Decimal y no Float: es dinero. Sin columna de moneda — sale de `Tenant.currency`,
  // que ya existe. Multi-moneda por trato cuando un tenant venda en dos.
  amount     Decimal?   @db.Decimal(14, 2)
  status     DealStatus @default(open)
  // Obligatorio al marcar perdido (lo exige el servicio, no el esquema): es el dato más
  // útil del CRM y el que nadie pone si es opcional. "Se fue con la competencia" tres
  // veces seguidas es una decisión de precio esperando a que alguien la lea.
  lostReason String?
  // Nulable a propósito: un trato sin dueño lo ve TODO el equipo y el primero que llega
  // lo reclama (ver `crm/deal-scope.ts`), igual que `agentScope` deja ver las
  // conversaciones abiertas. Es también lo que crea la regla de alta automática.
  ownerId    String?
  expectedCloseAt DateTime?
  // `status` y `closedAt` no pueden discrepar, así que los pone el mismo sitio y nunca
  // el cliente: cerrar lo sella, reabrir lo borra.
  closedAt   DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact    Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  pipeline   Pipeline   @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  // NoAction y NO Restrict, aunque el efecto buscado sea el mismo (no dejar tratos
  // apuntando a una etapa que ya no existe: borrar una etapa con tratos exige decir a
  // dónde van). Restrict se comprueba fila a fila y de inmediato, así que en un borrado
  // en cascada —tirar un Tenant, o una Pipeline— si Postgres llega a `Stage` antes que a
  // `Deal` la comprobación salta contra tratos que se están borrando en la MISMA
  // sentencia, y el borrado del tenant falla. NoAction se difiere al final de la
  // sentencia: para entonces los tratos ya no están y el diamante se resuelve.
  stage      Stage      @relation(fields: [stageId], references: [id], onDelete: NoAction)
  owner      User?      @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tasks      Task[]
  activities Activity[]

  // Un índice por consulta real, no por si acaso.
  @@index([tenantId, status])
  @@index([tenantId, pipelineId, stageId]) // el tablero
  @@index([tenantId, ownerId])             // alcance del agente
  @@index([tenantId, contactId])           // la ficha del cliente
}

// La próxima acción con fecha. Sin enum de estado: `completedAt` nulo es pendiente, y
// atrasada/hoy/próxima se DERIVAN de `dueAt` (`crm/tasks.buckets.ts`). Una columna de
// estado sería una copia que se desincroniza sola al pasar la medianoche.
model Task {
  id             String    @id @default(cuid())
  tenantId       String
  title          String
  type           TaskType  @default(call)
  // Obligatorio: una tarea sin fecha no aparece en ninguna lista y por lo tanto no existe.
  dueAt          DateTime
  // NO nulable: una tarea de "alguien del equipo" no la hace nadie, que es justo el
  // trato huérfano que este lote existe para evitar.
  assignedUserId String
  contactId      String?
  dealId         String?
  completedAt    DateTime?
  // "¿Qué pasó?" en el momento de cerrar, que es cuando se tiene la respuesta en la
  // cabeza. Se copia a la Activity del cierre.
  outcome        String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedUser User       @relation("TaskAssignee", fields: [assignedUserId], references: [id], onDelete: Cascade)
  createdBy    User?      @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  contact      Contact?   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal         Deal?      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  activities   Activity[]

  // El orden de las columnas importa: es exactamente "mis tareas pendientes por fecha",
  // la única consulta que corre en cada carga de pantalla.
  @@index([tenantId, assignedUserId, completedAt, dueAt])
  @@index([tenantId, dealId])
  @@index([tenantId, contactId])
}

// El timeline por contacto, append-only. Absorbe la vieja `Note`: dejarlas separadas
// daba dos sistemas de notas, y una nota escrita en la bandeja no aparecería en la ficha
// del cliente, que es justo donde el vendedor va a buscarla.
//
// Los MENSAJES no entran: el timeline es la columna de "qué pasó" y el chat va al lado,
// embebido. Unir Message con Activity en una consulta paginada es SQL caro para pintar
// dos veces lo mismo, y el hilo ya sabe paginarse solo.
model Activity {
  id             String       @id @default(cuid())
  tenantId       String
  type           ActivityType
  // OBLIGATORIO: el timeline es por contacto y siempre hay uno (un trato cuelga de un
  // contacto y una conversación también). Nulable, la consulta del timeline tendría que
  // hacer OR con dos joins.
  contactId      String
  dealId         String?
  conversationId String?
  taskId         String?
  // null = lo hizo el sistema. No hay usuario ficticio "Sistema": un User que no puede
  // entrar contamina GET /users, la asignación de conversaciones y el borrado de usuarios
  // — el mismo argumento con el que la 33 no crea usuarios pendientes.
  authorId       String?
  body           String?
  // Lo que solo se renderiza: {from,to} en un stage_change, {amount} en un deal_won.
  // Mismo criterio que `Message.payload`: si no se filtra ni se ordena por ello, no es
  // columna.
  data           Json?
  // Cuándo PASÓ, que no es cuándo se escribió: una llamada se registra después de
  // ocurrir. El timeline ordena por esto; la auditoría necesita `createdAt`.
  occurredAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact      Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal         Deal?         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  task         Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  author       User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([tenantId, contactId, occurredAt])
  @@index([tenantId, dealId, occurredAt])
  // La bandeja lista las notas de un hilo por este camino.
  @@index([conversationId, type])
}

// Etiqueta para DESCRIBIR y FILTRAR. No autoriza nada: decidir *a quién le envío* sigue
// siendo de `ContactList` (carteras), que tiene acceso por rol y es la única fuente de
// destinatarios de masivos. Conviene no volver a mezclar las dos cosas.
model Tag {
  id       String @id @default(cuid())
  tenantId String
  name     String
  // Token del sistema de diseño, no un hex libre: con hex libre el tenant elige un gris
  // sobre gris y la etiqueta deja de leerse en tema oscuro.
  color    String @default("neutral")
  createdAt DateTime @default(now())

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts ContactTag[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model ContactTag {
  contactId String
  tagId     String

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  // Un contacto tiene o no tiene la etiqueta, no hay más estado.
  @@id([contactId, tagId])
  @@index([tagId])
}

// Respuesta rápida: plantilla de texto interna del tenant para la caja de envío.
model CannedResponse {
  id        String   @id @default(cuid())
  tenantId  String
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, title])
  @@index([tenantId])
}
