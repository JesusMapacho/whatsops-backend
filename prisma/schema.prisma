generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  agent
}

enum WabaSource {
  embedded_signup
  manual_token
}

enum ConversationStatus {
  open
  pending
  closed
}

enum MessageDirection {
  in
  out
}

enum MessageStatus {
  sent
  delivered
  read
  failed
}

enum WebhookProcessStatus {
  pending
  ok
  failed
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  plan      String   @default("free")
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  roles           Role[]
  wabaConnections WabaConnection[]
  contacts        Contact[]
  conversations   Conversation[]
  messages        Message[]
  webhookEvents   WebhookEvent[]
  templates       Template[]
  notes           Note[]
  cannedResponses CannedResponse[]
}

// RBAC: roles configurables por tenant. admin/agent se siembran como isSystem
// para compatibilidad con el enum UserRole.
model Role {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       User[]
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

// Catálogo de permisos: la clave (recurso:accion) se siembra desde código
// (permissions.catalog.ts). No lleva tenantId: el catálogo es global; las
// asignaciones por tenant viven en RolePermission.
model Permission {
  id    String @id @default(cuid())
  key   String @unique

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  role         UserRole @default(agent)
  roleId       String?
  status       String   @default("active") // active | disabled
  isPlatform   Boolean  @default(false)    // super-admin operador (cross-tenant)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleRef             Role?          @relation(fields: [roleId], references: [id], onDelete: SetNull)
  assignedConversations Conversation[] @relation("AssignedAgent")
  notes               Note[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model WabaConnection {
  id              String     @id @default(cuid())
  tenantId        String
  wabaId          String?
  phoneNumberId   String
  accessTokenEnc  String
  businessId      String?
  source          WabaSource
  status          String     @default("active")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([tenantId])
  @@index([phoneNumberId])
}

model Contact {
  id        String   @id @default(cuid())
  tenantId  String
  waId      String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([tenantId, waId])
  @@index([tenantId])
}

model Conversation {
  id               String             @id @default(cuid())
  tenantId         String
  contactId        String
  wabaConnectionId String
  status           ConversationStatus @default(open)
  assignedUserId   String?
  lastInboundAt    DateTime?
  lastReadAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact        Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  wabaConnection WabaConnection @relation(fields: [wabaConnectionId], references: [id], onDelete: Cascade)
  assignedUser   User?          @relation("AssignedAgent", fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages       Message[]
  notes          Note[]

  @@index([tenantId])
  @@index([tenantId, status])
}

model Message {
  id             String           @id @default(cuid())
  tenantId       String
  conversationId String
  direction      MessageDirection
  type           String
  payload        Json
  wamid          String?          @unique
  status         MessageStatus    @default(sent)
  createdAt      DateTime         @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([conversationId])
}

model WebhookEvent {
  id             String               @id @default(cuid())
  tenantId       String?
  type           String
  rawPayload     Json
  signatureValid Boolean
  processStatus  WebhookProcessStatus @default(pending)
  error          String?
  processedAt    DateTime?
  createdAt      DateTime             @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([processStatus])
}

model Template {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  language  String
  category  String?
  status    String?
  body      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name, language])
  @@index([tenantId])
}

// Log core de errores de la API. tenantId/userId nullable (errores pre-auth o
// de plataforma). requestBody/query se guardan REDACTADOS (redact.ts): jamás
// tokens, passwords ni PAN. Sin FK: un usuario borrado no debe romper el log.
model ErrorLog {
  id           String   @id @default(cuid())
  tenantId     String?
  userId       String?
  method       String
  path         String
  statusCode   Int
  requestBody  Json?
  query        Json?
  errorMessage String
  errorCode    String?
  stack        String?
  requestId    String
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@index([statusCode])
  @@index([path])
  @@index([createdAt])
}

// Nota interna: visible para agentes, nunca se envía a WhatsApp.
model Note {
  id             String   @id @default(cuid())
  tenantId       String
  conversationId String
  authorId       String
  body           String
  createdAt      DateTime @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([conversationId])
}

// Respuesta rápida: plantilla de texto interna del tenant para la caja de envío.
model CannedResponse {
  id        String   @id @default(cuid())
  tenantId  String
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, title])
  @@index([tenantId])
}
